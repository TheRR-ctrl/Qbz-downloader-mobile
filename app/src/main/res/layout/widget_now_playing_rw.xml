<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF101A1F">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.35"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="9dp">

        <ImageView
            android:id="@+id/widget_cover"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_launcher" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:focusable="true"
                android:marqueeRepeatLimit="marquee_forever"
                android:shadowColor="#CC000000"
                android:shadowRadius="4"
                android:singleLine="true"
                android:text="QBDLX"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" >
                <requestFocus />
            </TextView>

            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:focusable="true"
                android:marqueeRepeatLimit="marquee_forever"
                android:shadowColor="#CC000000"
                android:shadowRadius="4"
                android:singleLine="true"
                android:textColor="#E6FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/widget_shuffle"
            android:layout_width="44dp"
            android:layout_height="32dp"
            android:background="@null"
            android:contentDescription="Shuffle"
            android:src="@drawable/ic_widget_shuffle_off" />
        <ImageButton
            android:id="@+id/widget_prev"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@null"
            android:contentDescription="@string/widget_previous"
            android:src="@android:drawable/ic_media_previous" />

        <ImageButton
            android:id="@+id/widget_play"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@null"
            android:contentDescription="@string/widget_play_pause"
            android:src="@android:drawable/ic_media_play" />

        <ImageButton
            android:id="@+id/widget_next"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@null"
            android:contentDescription="@string/widget_next"
            android:src="@android:drawable/ic_media_next" />
        <ImageButton
            android:id="@+id/widget_repeat"
            android:layout_width="44dp"
            android:layout_height="32dp"
            android:background="@null"
            android:contentDescription="Repeat"
            android:src="@drawable/ic_widget_repeat_off" />
    </LinearLayout>
</FrameLayout>
